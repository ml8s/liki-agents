{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liki.hk/contracts/agui-forwarded-props-v1.json",
  "title": "Liki AG-UI forwarded properties",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "locale"],
  "properties": {
    "product": {"const": "liki"},
    "locale": {"enum": ["zh-Hans", "zh-Hant", "en"]},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendar", "gender", "birth_date", "birth_time_known"],
      "properties": {
        "calendar": {"enum": ["solar", "lunar"]},
        "gender": {"enum": ["male", "female"]},
        "birth_date": {"type": "string", "minLength": 1},
        "birth_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "birth_time_known": {"enum": ["known", "approximate", "unknown"]},
        "birth_place": {"type": "string"}
      }
    }
  }
}
