LIKI_ENV=development
LIKI_AGENT_ADDR=:8083
LIKI_AGENT_PUBLIC_URL=http://127.0.0.1:8083
LIKI_AGENT_INTERNAL_TOKEN=dev-agent-token
LIKI_AGENT_DATA_DIR=./data
LIKI_DB_PATH=./data/liki-agent-audit.db

LIKI_ENGINE_MCP_URL=http://127.0.0.1:18081/mcp
LIKI_ENGINE_MCP_TOKEN=
LIKI_ENGINE_CONTRACT_VERSION=2026.09.23.1
LIKI_ENGINE_TIMEOUT_SECONDS=30
LIKI_PROMPT_VERSION=chief-analysis-v1
LIKI_POLICY_VERSION=destiny-safety-v1
LIKI_RUN_TIMEOUT_SECONDS=600
LIKI_SHUTDOWN_TIMEOUT_SECONDS=30
LIKI_ENGINE_ALLOWED_TOOLS=bazhai_chart,bazhai_layout,bazi_bond,bazi_chart,bazi_fullchart,bazi_liunian,bazi_liuri,bazi_liushi,bazi_liuyue,bazi_xiaoyun,city_coords,huangli_days,liuyao_chart,liuyao_qigua,qimen_chart,tianwen_time,time_now,xuankong_chart,xuankong_liunian,ziwei_bond,ziwei_chart,ziwei_daxian,ziwei_fullchart,ziwei_liunian,ziwei_liuri,ziwei_liushi,ziwei_liuyue
LIKI_AGENT_NAME=chief_analyst
LIKI_AGENT_DESCRIPTION="Grounded destiny analysis assistant"
LIKI_EXPERT_NAME=chief_analyst
LIKI_EXPERT_SYSTEM=chief

LIKI_LLM_BASE_URL=https://api.openai.com/v1
LIKI_LLM_API_KEY=
LIKI_LLM_MODEL=gpt-4.1-mini
LIKI_LLM_PROVIDER=openai-compatible
LIKI_LLM_TIMEOUT_SECONDS=120
LIKI_LLM_TEMPERATURE=0.2

LIKI_LOG_FORMAT=json
LIKI_LOG_LEVEL=info
