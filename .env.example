LIKI_ENV=development
LIKI_AGENTS_ADDR=:8083
LIKI_AGENTS_PUBLIC_URL=http://127.0.0.1:8083
LIKI_AGENTS_INTERNAL_TOKEN=dev-agent-token
LIKI_AGENTS_DATA_DIR=./data
LIKI_DB_PATH=./data/liki-agents-audit.db
LIKI_AGENTS_DEPLOYMENT_FILE=./dev/agent-deployment/deployment.json

# Provided by the Liki/Engine project or an external test environment.
LIKI_ENGINE_MCP_URL=http://127.0.0.1:18081/mcp
LIKI_ENGINE_MCP_TOKEN=
LIKI_ENGINE_CONTRACT_VERSION=2026.09.23.1
LIKI_ENGINE_TIMEOUT_SECONDS=30
LIKI_RUN_TIMEOUT_SECONDS=600
LIKI_SHUTDOWN_TIMEOUT_SECONDS=30

LIKI_LLM_BASE_URL=https://open.bigmodel.cn/api/v1
LIKI_LLM_API_KEY=
LIKI_LLM_MODEL=glm-5.3-flash
LIKI_LLM_PROVIDER=zhipu
# Leave empty for a plain-text AgentDeployment; use json_schema or json_object
# only when at least one Agent declares an output schema.
LIKI_LLM_STRUCTURED_OUTPUT=
LIKI_LLM_TIMEOUT_SECONDS=120
LIKI_LLM_TEMPERATURE=0.2

# OpenTelemetry traces (standard OTLP environment variables)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1

LIKI_LOG_FORMAT=json
LIKI_LOG_LEVEL=info
